{
  "schema": "levelupdiag.config.v2",
  "target_repo_root": "C:/mycode/Orgo/Orgo",
  "control_dir": ".levelupdiag",
  "execution": {
    "max_parallel": 4,
    "default_timeout_seconds": 120,
    "fail_fast": false,
    "capture_limit_kb": 256,
    "protect_tracked_files": true,
    "allow_target_mutation": false,
    "allow_network": false,
    "restore_generated_tracked_files": [
      "apps/web/next-env.d.ts"
    ]
  },
  "scan": {
    "exclude_dirs": [
      ".git",
      ".hg",
      ".svn",
      ".levelupdiag",
      "levelupdiag",
      "node_modules",
      ".next",
      "legacy",
      "validation",
      "vendor",
      "dist",
      "build",
      "target",
      ".venv",
      "venv",
      "__pycache__",
      ".cache",
      "coverage",
      ".tox",
      ".mypy_cache",
      ".pytest_cache"
    ],
    "max_files": 20000,
    "max_file_bytes": 1048576,
    "max_security_files": 4000,
    "large_file_bytes": 10485760
  },
  "toolchain": {
    "required": [],
    "optional": []
  },
  "validators": [],
  "security": {
    "enabled": true,
    "scan_untracked": false,
    "additional_patterns": [],
    "additional_excluded_globs": []
  },
  "redaction": {
    "enabled": true,
    "replacement": "<REDACTED>"
  },
  "database": {
    "target_env_file": ".env",
    "test_database_url": "postgresql://orgo_test:orgo_test@127.0.0.1:5432/orgo_test?connection_limit=5"
  },
  "ecosystem": {
    "kor_repo_root": "C:/mycode/Kor/kor",
    "orgo_api_url": "http://127.0.0.1:4000",
    "orgo_web_url": "http://127.0.0.1:3000",
    "android_mode": "emulator"
  }
}
