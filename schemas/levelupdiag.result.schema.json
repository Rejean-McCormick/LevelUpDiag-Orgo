{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://levelupdiag.local/schemas/levelupdiag.result.schema.json",
  "title": "LevelUpDiag-Koali Level Result",
  "type": "object",
  "required": [
    "schema",
    "standard",
    "standard_version",
    "level",
    "name",
    "verdict",
    "findings"
  ],
  "properties": {
    "schema": {
      "const": "levelupdiag.report.v1"
    },
    "standard": {
      "const": "LevelUpDiag"
    },
    "standard_version": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "type": "string",
      "pattern": "^N[0-9]{2}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "enum": [
        "PASS",
        "WARN",
        "FAIL",
        "SKIP",
        "BLOCKED",
        "PARTIAL",
        "ERROR",
        "INFRA_ERROR",
        "CONFIG_ERROR"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "started_at": {
      "type": "string"
    },
    "ended_at": {
      "type": "string"
    },
    "duration_seconds": {
      "type": "number",
      "minimum": 0
    },
    "exit_code": {
      "type": ["integer", "null"]
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cwd": {
      "type": "string"
    },
    "output_tail": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["id", "severity", "message"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "severity": {
          "enum": [
            "PASS",
            "WARN",
            "FAIL",
            "SKIP",
            "BLOCKED",
            "PARTIAL",
            "ERROR",
            "INFRA_ERROR",
            "CONFIG_ERROR"
          ]
        },
        "message": {"type": "string", "minLength": 1},
        "category": {"type": "string"},
        "path": {"type": ["string", "null"]},
        "evidence": {"type": ["string", "null"]},
        "recommendation": {"type": ["string", "null"]},
        "data": {"type": "object"}
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["kind", "path"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "description": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
