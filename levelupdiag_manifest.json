{
  "schema": "levelupdiag.manifest.v2",
  "standard": "LevelUpDiag",
  "standard_version": "1.0.0",
  "suite_name": "LevelUpDiag Neutral Frame",
  "suite_version": "1.0.0",
  "repository_mode": "copy-in-neutral-diagnostics-frame",
  "control_dir_default": ".levelupdiag",
  "levels": [
    {
      "id": "N00",
      "name": "Diagnostic Integrity",
      "module": "levels.n00_diagnostic_integrity",
      "category": "diagnostics",
      "order": 0,
      "required": true,
      "depends_on": [],
      "timeout_seconds": 60,
      "parallel_safe": true,
      "purpose": "Validate the diagnostics frame before trusting its output."
    },
    {
      "id": "N01",
      "name": "Target Context",
      "module": "levels.n01_target_context",
      "category": "context",
      "order": 10,
      "required": true,
      "depends_on": [
        "N00"
      ],
      "timeout_seconds": 60,
      "parallel_safe": true,
      "purpose": "Resolve target, runtime context, VCS state, paths and basic executability."
    },
    {
      "id": "N02",
      "name": "Repository Inventory",
      "module": "levels.n02_repository_inventory",
      "category": "inventory",
      "order": 20,
      "required": true,
      "depends_on": [
        "N01"
      ],
      "timeout_seconds": 120,
      "parallel_safe": true,
      "purpose": "Collect bounded technology-neutral evidence about repository shape and capabilities."
    },
    {
      "id": "N03",
      "name": "Repository Hygiene",
      "module": "levels.n03_repository_hygiene",
      "category": "hygiene",
      "order": 30,
      "required": true,
      "depends_on": [
        "N02"
      ],
      "timeout_seconds": 180,
      "parallel_safe": true,
      "purpose": "Detect repository-level integrity and hygiene hazards."
    },
    {
      "id": "N04",
      "name": "Tooling Discovery",
      "module": "levels.n04_tooling_discovery",
      "category": "tooling",
      "order": 40,
      "required": true,
      "depends_on": [
        "N02"
      ],
      "timeout_seconds": 120,
      "parallel_safe": true,
      "purpose": "Discover project manifests, automation surfaces and candidate tools without making them mandatory."
    },
    {
      "id": "N05",
      "name": "Declared Validations",
      "module": "levels.n05_declared_validations",
      "category": "validation",
      "order": 50,
      "required": true,
      "depends_on": [
        "N01",
        "N02"
      ],
      "timeout_seconds": 1800,
      "parallel_safe": false,
      "purpose": "Execute only validations explicitly declared by the local diagnostics configuration."
    },
    {
      "id": "N06",
      "name": "Security Hygiene",
      "module": "levels.n06_security_hygiene",
      "category": "security_hygiene",
      "order": 60,
      "required": true,
      "depends_on": [
        "N02"
      ],
      "timeout_seconds": 180,
      "parallel_safe": true,
      "purpose": "Perform bounded conservative hygiene checks without claiming a security audit."
    }
  ],
  "campaigns": {
    "baseline": {
      "description": "Universal read-oriented diagnostics with no target command execution.",
      "levels": [
        "N00",
        "N01",
        "N02",
        "N03",
        "N04",
        "N06"
      ]
    },
    "standard": {
      "description": "Baseline plus explicitly declared validators.",
      "levels": [
        "N00",
        "N01",
        "N02",
        "N03",
        "N04",
        "N05",
        "N06"
      ]
    },
    "deep": {
      "description": "Neutral extension campaign; customize only with target-justified checks.",
      "levels": [
        "N00",
        "N01",
        "N02",
        "N03",
        "N04",
        "N05",
        "N06"
      ]
    }
  }
}
