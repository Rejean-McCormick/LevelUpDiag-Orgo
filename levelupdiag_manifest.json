{
  "schema": "levelupdiag.manifest.v2",
  "standard": "LevelUpDiag",
  "standard_version": "1.0.0",
  "suite_name": "LevelUpDiag-Orgo",
  "suite_version": "1.2.0",
  "repository_mode": "standalone-external-target",
  "control_dir_default": ".levelupdiag",
  "levels": [
    {"id":"N15","name":"Playwright browser acceptance","module":"levels.orgo_browser","order":150,"required":true,"depends_on":["N07"],"timeout_seconds":950,"parallel_safe":false},
    {"id":"N07","name":"Orgo preflight","module":"levels.orgo_validation","order":70,"required":true,"depends_on":["N00","N01"],"timeout_seconds":60,"parallel_safe":true},
    {"id":"N08","name":"Schema, architecture and types","module":"levels.orgo_validation","order":80,"required":true,"depends_on":["N07"],"timeout_seconds":3700,"parallel_safe":false},
    {"id":"N09","name":"Business unit tests","module":"levels.orgo_validation","order":90,"required":true,"depends_on":["N08"],"timeout_seconds":1250,"parallel_safe":false},
    {"id":"N10","name":"Disposable PGlite integration","module":"levels.orgo_validation","order":100,"required":true,"depends_on":["N08"],"timeout_seconds":1250,"parallel_safe":false},
    {"id":"N11","name":"Native PostgreSQL integration","module":"levels.orgo_validation","order":110,"required":true,"depends_on":["N08"],"timeout_seconds":2500,"parallel_safe":false},
    {"id":"N12","name":"API and web production builds","module":"levels.orgo_validation","order":120,"required":true,"depends_on":["N08"],"timeout_seconds":1250,"parallel_safe":false},
    {"id":"N13","name":"Dependency audit (moderate+)","module":"levels.orgo_validation","order":130,"required":true,"depends_on":["N07"],"timeout_seconds":1250,"parallel_safe":false},
    {"id":"N14","name":"Local acceptance boundary","module":"levels.orgo_validation","order":140,"required":true,"depends_on":["N07"],"timeout_seconds":60,"parallel_safe":false},
    {
      "id": "N00",
      "name": "Diagnostic Integrity",
      "module": "levels.n00_diagnostic_integrity",
      "category": "diagnostics",
      "order": 0,
      "required": true,
      "depends_on": [],
      "timeout_seconds": 60,
      "parallel_safe": true,
      "purpose": "Validate the diagnostics frame before trusting its output."
    },
    {
      "id": "N01",
      "name": "Target Context",
      "module": "levels.n01_target_context",
      "category": "context",
      "order": 10,
      "required": true,
      "depends_on": [
        "N00"
      ],
      "timeout_seconds": 60,
      "parallel_safe": true,
      "purpose": "Resolve target, runtime context, VCS state, paths and basic executability."
    },
    {
      "id": "N02",
      "name": "Repository Inventory",
      "module": "levels.n02_repository_inventory",
      "category": "inventory",
      "order": 20,
      "required": true,
      "depends_on": [
        "N01"
      ],
      "timeout_seconds": 120,
      "parallel_safe": true,
      "purpose": "Collect bounded technology-neutral evidence about repository shape and capabilities."
    },
    {
      "id": "N03",
      "name": "Repository Hygiene",
      "module": "levels.n03_repository_hygiene",
      "category": "hygiene",
      "order": 30,
      "required": true,
      "depends_on": [
        "N02"
      ],
      "timeout_seconds": 180,
      "parallel_safe": true,
      "purpose": "Detect repository-level integrity and hygiene hazards."
    },
    {
      "id": "N04",
      "name": "Tooling Discovery",
      "module": "levels.n04_tooling_discovery",
      "category": "tooling",
      "order": 40,
      "required": true,
      "depends_on": [
        "N02"
      ],
      "timeout_seconds": 120,
      "parallel_safe": true,
      "purpose": "Discover project manifests, automation surfaces and candidate tools without making them mandatory."
    },
    {
      "id": "N05",
      "name": "Declared Validations",
      "module": "levels.n05_declared_validations",
      "category": "validation",
      "order": 50,
      "required": true,
      "depends_on": [
        "N01",
        "N02"
      ],
      "timeout_seconds": 1800,
      "parallel_safe": false,
      "purpose": "Execute only validations explicitly declared by the local diagnostics configuration."
    },
    {
      "id": "N06",
      "name": "Security Hygiene",
      "module": "levels.n06_security_hygiene",
      "category": "security_hygiene",
      "order": 60,
      "required": true,
      "depends_on": [
        "N02"
      ],
      "timeout_seconds": 180,
      "parallel_safe": true,
      "purpose": "Perform bounded conservative hygiene checks without claiming a security audit."
    }
  ],
  "campaigns": {
    "browser": {"description":"Seven Chromium journeys against a running local test instance; separate from deep and manual acceptance.","levels":["N15"]},
    "quick": {"description":"Preflight, generated client, architecture, types and unit tests.","levels":["N07","N08","N09"]},
    "database": {"description":"Real PostgreSQL migration and integration on an explicitly selected disposable database.","levels":["N09","N11"]},
    "embedded": {"description":"Disposable PGlite integration, not native concurrency acceptance.","levels":["N09","N10"]},
    "build": {"description":"Production API and frontend compilation.","levels":["N12"]},
    "security": {"description":"Repository hygiene and npm vulnerability audit, no automatic fixes.","levels":["N06","N13"]},
    "acceptance": {"description":"Automated deep validation plus explicit manual acceptance boundary (BLOCKED until local review).","levels":["N09","N11","N12","N13","N14"]},
    "baseline": {
      "description": "Universal read-oriented diagnostics with no target command execution.",
      "levels": [
        "N00",
        "N01",
        "N02",
        "N03",
        "N04",
        "N06"
      ]
    },
    "standard": {
      "description": "Orgo static checks and business unit tests plus baseline.",
      "levels": [
        "N00",
        "N01",
        "N02",
        "N03",
        "N04",
        "N08", "N09",
        "N06"
      ]
    },
    "deep": {
      "description": "Orgo native database, unit tests, builds and dependency audit. Explicit local permissions required.",
      "levels": [
        "N00",
        "N01",
        "N02",
        "N03",
        "N04",
        "N08", "N09", "N11", "N12", "N13",
        "N06"
      ]
    }
  }
