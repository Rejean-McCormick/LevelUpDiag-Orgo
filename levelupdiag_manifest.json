    {
      "id": "N11",
      "name": "Delivery",
      "file": "levels/N11_delivery.pyw",
      "enabled": true,
      "required": false,
      "depends_on": [
        "N01"
      ],
      "timeout_seconds": 300,
      "purpose": "Vérifier l'absence de l'appendice dans une cible de livraison."
    }
